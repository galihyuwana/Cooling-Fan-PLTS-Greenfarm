    {
        "id": "53b5d2ea171d2603",
        "type": "ui-template",
        "z": "4c977091367a5b88",
        "group": "8e6f4ca94d91960f",
        "page": "",
        "ui": "",
        "name": "Device Status Card",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div class=\"custom-header\">\n\n  <div class=\"header-left\">\n\n    <a href=\"/dashboard/Home\" class=\"back-btn\">\n      ← Back\n    </a>\n\n    <span class=\"header-title\">\n      PLTS COOLING MONITORING\n    </span>\n\n  </div>\n\n  <div class=\"header-device\">\n    PLTS-01\n  </div>\n\n</div>\n\n<style>\n  .custom-header {\n    width: 100%;\n    height: 64px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    padding: 0 24px;\n\n    background: #166534;\n    color: white;\n\n    border-radius: 10px;\n\n    box-sizing: border-box;\n\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);\n  }\n\n  .header-left {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n  }\n\n  .header-title {\n    font-size: 20px;\n    font-weight: 700;\n  }\n\n  .header-device {\n    font-size: 15px;\n    font-weight: 600;\n  }\n\n  .back-btn {\n    padding: 7px 14px;\n\n    background: #22c55e;\n    color: white !important;\n\n    text-decoration: none;\n\n    border-radius: 7px;\n\n    font-weight: 600;\n\n    transition: 0.2s;\n  }\n\n  .back-btn:hover {\n    background: #facc15;\n    color: black !important;\n  }\n\n  @media (max-width: 600px) {\n\n    .custom-header {\n      padding: 0 12px;\n    }\n\n    .header-title {\n      font-size: 14px;\n    }\n\n    .header-device {\n      font-size: 12px;\n    }\n\n    .back-btn {\n      padding: 6px 10px;\n      font-size: 12px;\n    }\n  }\n</style>\n\n<div style=\"\n    padding:0px 18px;\n    border-radius: 14px;\n    background: rgba(255,255,255,0.06);\n  \">\n    <a href=\"/dashboard/Home\" class=\"back-btn\">\n      ←  BACK\n    </a>\n\n    <style>\n      .back-btn {\n        display: inline-block;\n        padding: 8px 16px;\n        background-color: #397b35;\n        color: white !important;\n        text-decoration: none;\n        border-radius: 8px;\n        border: none;\n        font-weight: 600;\n        font-size:15px;\n        transition: 0.2s;\n      }\n\n      .back-btn:hover {\n        background-color: #3b572f;\n        color: white !important;\n      }\n    </style>\n\n  <div style=\"\n      display:flex;\n      justify-content:space-between;\n      align-items:center;\n      margin-bottom:18px;\n      margin-top:10px;\n  \">\n  <div>\n        <div style=\"\n        font-size:20px;\n        font-weight:700;\n    \">\n      {{ msg.payload.device_id }}\n    </div>\n      <div style=\"font-size:12px;\">\n        Last Update :\n                 {{\n          new Date(msg.payload.last_seen).toLocaleTimeString('id-ID')\n          }}\n      </div>\n  </div>\n\n\n    <div style=\"\n        display:flex;\n        gap:18px;\n        align-items:center;\n    \">\n\n        <span v-if=\"msg.payload.online\" style=\"color: green; font-weight: bold;\">\n          ● ONLINE\n        </span>\n\n        <span v-else style=\"color: red; font-weight: bold;\">\n         ● OFFLINE\n        </span>\n\n      <div>\n        {{ msg.payload.wifi_rssi }} dBm\n      </div>\n\n    </div>\n\n  </div>\n\n\n  <div style=\"\n      text-align:center;\n      font-size:46px;\n      font-weight:700;\n      margin:16px 0 24px 0;\n  \">\n    {{ msg.payload.temperature }} °C\n  </div>\n\n\n  <div style=\"\n      display:grid;\n      grid-template-columns:1fr 1fr;\n      gap:14px;\n  \">\n\n    <div>\n      Status Suhu :\n      <b>{{ msg.payload.temperature_status }}</b>\n    </div>\n\n    <div style=\"text-align:right;\">\n      Fan :\n      <b>{{ msg.payload.fan ? 'ON' : 'OFF' }}</b>\n    </div>\n\n    <div>\n      Mode :\n      <b>{{ msg.payload.mode }}</b>\n    </div>\n\n    <div style=\"text-align:right;\">\n      Sensor :\n      <b>{{ msg.payload.sensor === 'OK' ? 'Terhubung' : 'Error' }}</b>\n    </div>\n\n  </div>\n\n</div>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
