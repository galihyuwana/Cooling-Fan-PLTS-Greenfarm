            ]
        ]
    },
    {
        "id": "85b959804d923fc2",
        "type": "function",
        "z": "4c977091367a5b88",
        "name": "Format History",
        "func": "let rows = msg.payload;\n\nif (!Array.isArray(rows) || rows.length === 0) {\n    return null;\n}\n\nlet points = [];\nlet previousTime = null;\n\n// Batas dianggap putus/offline\n// 2 menit = 120000 ms\nconst GAP_LIMIT = 120000;\n\nfor (let row of rows) {\n\n    let currentTime = new Date(\n        row.timestamp.replace(\" \", \"T\") + \"Z\"\n    ).getTime();\n\n    let temperature = Number(row.temperature);\n\n    // Kalau jarak dengan data sebelumnya terlalu jauh,\n    // masukkan NULL agar garis grafik terputus.\n    if (\n        previousTime !== null &&\n        (currentTime - previousTime) > GAP_LIMIT\n    ) {\n\n        points.push({\n            x: previousTime + 1000,\n            y: null\n        });\n\n        points.push({\n            x: currentTime - 1000,\n            y: null\n        });\n    }\n\n    points.push({\n        x: currentTime,\n        y: temperature\n    });\n\n    previousTime = currentTime;\n}\n\nmsg.payload = points;\nmsg.topic = \"Temperature\";\nmsg.action = \"replace\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
