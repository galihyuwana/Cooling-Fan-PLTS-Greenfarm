        "func": "if (msg.topic !== \"$pageview\") {\n    return null;\n}\n\nif (!msg.payload || !msg.payload.query) {\n    return null;\n}\n\nlet device = msg.payload.query.device;\n\nif (!device) {\n    return null;\n}\n\nflow.set(\"selected_device\", device);\n\nif (!flow.get(\"history_range\")) {\n    flow.set(\"history_range\", \"1h\");\n}\n\nnode.warn(\"Selected Device = \" + device);\n\nmsg.payload = device;\n\nreturn msg;",
