    {
        "id": "8255c6c8beaf5cca",
        "type": "function",
        "z": "4c977091367a5b88",
        "name": "Update Device Status",
        "func": "let data = msg.payload;\n\nif (!data || !data.device_id) {\n    return null;\n}\n\nlet now = Date.now();\n\ndata.last_seen = now;\ndata.online = true;\n\nlet device = data.device_id;\n\nflow.set(device + \"_status\", data);\nflow.set(device + \"_last_seen\", now);\nflow.set(device + \"_online\", true);\n\nmsg.payload = data;\n\nreturn msg;",
        "outputs": 1,
