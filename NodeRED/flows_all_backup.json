    {
        "id": "4adffa9b895a910a",
        "type": "function",
        "z": "4c977091367a5b88",
        "name": "Temperature",
        "func": "let d = msg.payload;\n\nif (!d || d.temperature === undefined) {\n    return null;\n}\n\nlet now = Date.now();\n\nlet device = d.device_id || \"unknown\";\n\nlet key = \"chart_last_\" + device;\n\nlet lastTime = flow.get(key) || 0;\n\nflow.set(key, now);\n\nconst GAP_LIMIT = 15000;   // 15 detik\n\n// Kalau sebelumnya sudah lama tidak ada data,\n// buat titik NULL dahulu.\nif (\n    lastTime !== 0 &&\n    (now - lastTime) > GAP_LIMIT\n) {\n\n    let gapMsg = {\n        topic: \"Temperature\",\n        action: \"append\",\n        payload: {\n            x: lastTime + 1000,\n            y: null\n        }\n    };\n\n    let currentMsg = {\n        topic: \"Temperature\",\n        action: \"append\",\n        payload: {\n            x: now,\n            y: Number(d.temperature)\n        }\n    };\n\n    return [gapMsg, currentMsg];\n}\n\n// Normal realtime\nmsg.payload = {\n    x: now,\n    y: Number(d.temperature)\n};\n\nmsg.topic = \"Temperature\";\nmsg.action = \"append\";\n\nreturn msg;",
        "outputs": 1,
