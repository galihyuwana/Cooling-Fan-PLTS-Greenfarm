        "name": "Update Device registery",
        "func": "let data = msg.payload;\n\nif (!data || !data.device_id) {\n    return null;\n}\n\nlet devices = flow.get(\"devices\") || {};\n\ndata.last_seen = Date.now();\n\ndevices[data.device_id] = data;\n\nflow.set(\"devices\", devices);\n\nreturn null;",
