    {
        "id": "fcdc414749a9c9c7",
        "type": "function",
        "z": "4c977091367a5b88",
        "name": "Prepare Cached Status",
        "func": "let data = msg.payload;\n\nif (!data || !data.device_id) {\n    return null;\n}\n\nlet lastSeen = data.last_seen || 0;\n\n// Tentukan status berdasarkan waktu data terakhir,\n// BUKAN berdasarkan waktu halaman dibuka\ndata.online = (Date.now() - lastSeen) <= 15000;\n\nmsg.payload = data;\n\nreturn msg;",
