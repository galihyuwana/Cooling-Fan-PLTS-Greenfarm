    {
        "id": "9c03050434b872e0",
        "type": "function",
        "z": "4c977091367a5b88",
        "name": "Save Temperature",
        "func": "let d = msg.payload;\n\nif (!d || !d.device_id) {\n    return null;\n}\n\nmsg.topic = `\nINSERT INTO temperature_history\n(\n    device_id,\n    temperature,\n    fan,\n    mode,\n    temperature_status,\n    sensor,\n    wifi_rssi\n)\nVALUES\n(\n    '${d.device_id}',\n    ${Number(d.temperature)},\n    ${d.fan ? 1 : 0},\n    '${d.mode}',\n    '${d.temperature_status}',\n    '${d.sensor}',\n    ${Number(d.wifi_rssi)}\n)\n`;\n\nreturn msg;",
