    {
        "id": "04075434c99d1f60",
        "type": "function",
        "z": "4c977091367a5b88",
        "name": "Check Device Online",
        "func": "let device = flow.get(\"selected_device\");\n\nif (!device) {\n    return null;\n}\n\nlet lastSeen = flow.get(device + \"_last_seen\");\nlet online   = flow.get(device + \"_online\");\nlet data     = flow.get(device + \"_status\");\n\nif (!lastSeen || !data) {\n    return null;\n}\n\nlet now = Date.now();\nlet selisih = now - lastSeen;\n\nif (selisih > 15000) {\n\n    if (online === true) {\n\n        data.online = false;\n\n        flow.set(device + \"_online\", false);\n        flow.set(device + \"_status\", data);\n\n        msg.payload = data;\n\n        return msg;\n    }\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 360,
        "wires": [
            [
                "53b5d2ea171d2603"
            ]
        ]
    },
