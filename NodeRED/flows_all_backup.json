    {
        "id": "aea46547ca417cc1",
        "type": "ui-template",
        "z": "4c977091367a5b88",
        "group": "be9fee48ef16efd9",
        "page": "",
        "ui": "",
        "name": "Device List",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div class=\"custom-header\">\n\n  <div class=\"header-left\">\n    <span class=\"header-icon\">☀</span>\n\n    <span class=\"header-title\">\n      COOLING FAN PLTS MONITORING\n    </span>\n  </div>\n\n  <!-- <div class=\"header-right\">\n    <span class=\"system-dot\">●</span>\n    <span>SYSTEM ONLINE</span>\n  </div> -->\n\n</div>\n\n<style>\n.custom-header {\n  width: 100%;\n  height: 64px;\n\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  padding: 0 24px;\n\n  background: #166534;\n  color: white;\n\n  border-radius: 10px;\n\n  box-sizing: border-box;\n\n  box-shadow: 0 2px 8px rgba(0,0,0,0.15);\n}\n\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.header-icon {\n  font-size: 25px;\n}\n\n.header-title {\n  font-size: 20px;\n  font-weight: 700;\n  letter-spacing: 0.5px;\n}\n\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.system-dot {\n  color: #4ade80;\n  font-size: 16px;\n}\n\n@media (max-width: 600px) {\n\n  .custom-header {\n    height: 56px;\n    padding: 0 14px;\n  }\n\n  .header-title {\n    font-size: 15px;\n  }\n\n  .header-right {\n    font-size: 11px;\n  }\n\n  .header-icon {\n    font-size: 20px;\n  }\n}\n</style>\n<div style=\"\n    display:grid;\n    grid-template-columns:\n        repeat(auto-fit, minmax(280px, 1fr));\n    gap:16px;\n    padding:8px;\n\">\n\n    <div v-for=\"device in msg.payload\" :key=\"device.device_id\" style=\"\n            border:1px solid #ddd;\n            border-radius:14px;\n            padding:18px;\n            min-height:170px;\n        \">\n\n        <!-- HEADER -->\n        <div style=\"\n            display:flex;\n            justify-content:space-between;\n            align-items:center;\n            margin-bottom:20px;\n        \">\n\n            <b style=\"font-size:20px;\">\n                {{ device.device_id }}\n            </b>\n            <div>\n                <b\n                    :style=\"{\n                        color: device.online ? '#16a34a' : '#dc2626',\n                        fontWeight: '700'\n                    }\"\n                >\n                    {{ device.online ? '● ONLINE' : '● OFFLINE' }}\n                </b>\n                <v-icon :icon=\"\n                        !device.online\n                            ? 'mdi-wifi-strength-off-outline'\n                        : device.wifi_rssi >= -55\n                            ? 'mdi-wifi-strength-4'\n                        : device.wifi_rssi >= -67\n                            ? 'mdi-wifi-strength-3'\n                        : device.wifi_rssi >= -75\n                            ? 'mdi-wifi-strength-2'\n                        : 'mdi-wifi-strength-1'\n                    \" size=\"28\" :style=\"{\n                        color: !device.online\n                            ? '#9ca3af'\n                            : device.wifi_rssi >= -67\n                                ? '#16a34a'\n                            : device.wifi_rssi >= -75\n                                ? '#f59e0b'\n                                : '#dc2626'\n                }\"></v-icon>\n            </div>\n\n        </div>\n\n\n        <!-- TEMPERATURE -->\n        <div style=\"\n            display:flex;\n            justify-content:space-between;\n            align-items:center;\n            margin-bottom:12px;\n        \">\n\n            <span style=\"\n                font-size:30px;\n                font-weight:700;\n            \">\n                {{ device.online\n                    ? device.temperature + ' °C'\n                    : '-- °C' }}\n            </span>\n\n            <span>\n                Fan :\n                <b>\n                    {{ device.fan ? 'ON' : 'OFF' }}\n                </b>\n            </span>\n\n        </div>\n\n\n        <!-- INFORMATION -->\n        <div style=\"\n            display:flex;\n            justify-content:space-between;\n            margin-bottom:20px;\n        \">\n\n            <span>\n                Mode :\n                <b>{{ device.mode }}</b>\n            </span>\n\n        </div>\n\n\n        <!-- BUTTON -->\n        <!-- <a :href=\"'/dashboard/Detail?device='\n                + device.device_id\" style=\"\n                display:block;\n                text-align:center;\n                text-decoration:none;\n                padding:10px;\n                border:1px solid #aaa;\n                border-radius:8px;\n            \">\n            Lihat Device →\n        </a> -->\n\n        <a\n          :href=\"'/dashboard/Detail?device=' + device.device_id\"\n          class=\"detail-btn\"\n        >\n          Lihat Device →\n        </a>\n        <style>\n          .detail-btn{\n            display:block;\n                text-align:center;\n                text-decoration:none;\n                padding:10px;\n                border:1px solid #aaa;\n                border-radius:8px;\n          }\n        </style>\n        \n        <button\n          @click=\"deleteDevice(device.device_id)\"\n          style=\"\n            margin-top:16px;\n            width:100%;\n            padding:8px;\n            border:1px solid #dc2626;\n            border-radius:6px;\n            background:white;\n            color:#dc2626;\n            cursor:pointer;\n          \"\n        >\n          Hapus Device\n        </button>\n    </div>\n\n</div>\n\n<script>\nexport default {\n  methods: {\n\n    deleteDevice(deviceId) {\n\n      if (!confirm(\"Hapus device \" + deviceId + \"?\")) {\n        return;\n      }\n\n      this.send({\n        topic: \"delete_device\",\n        payload: deviceId\n      });\n\n    }\n\n  }\n}\n</script>",
