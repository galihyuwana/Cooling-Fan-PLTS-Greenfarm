    {
        "id": "306efee01756cc9b",
        "type": "function",
        "z": "4c977091367a5b88",
        "name": "Query History",
        "func": "let device = flow.get(\"selected_device\");\nlet range = flow.get(\"history_range\") || \"1h\";\n\nif (!device) {\n    return null;\n}\n\nif (!/^[A-Za-z0-9_-]+$/.test(device)) {\n    return null;\n}\n\nlet sqliteRange;\n\nswitch (range) {\n\n    case \"30m\":\n        sqliteRange = \"-30 minutes\";\n        break;\n\n    case \"1h\":\n        sqliteRange = \"-1 hour\";\n        break;\n\n    case \"3h\":\n        sqliteRange = \"-3 hours\";\n        break;\n\n    case \"6h\":\n        sqliteRange = \"-6 hours\";\n        break;\n\n    case \"24h\":\n        sqliteRange = \"-24 hours\";\n        break;\n\n    case \"7d\":\n        sqliteRange = \"-7 days\";\n        break;\n\n    default:\n        sqliteRange = \"-1 hour\";\n}\n\nmsg.topic = `\nSELECT\n    timestamp,\n    temperature\nFROM temperature_history\nWHERE device_id = '${device}'\n  AND timestamp >= datetime('now', '${sqliteRange}')\nORDER BY timestamp ASC;\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 600,
