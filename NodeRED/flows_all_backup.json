        "id": "2135709f3f87e498",
        "type": "function",
        "z": "4c977091367a5b88",
        "name": "Delete Device",
        "func": "if (msg.topic !== \"delete_device\") {\n    return null;\n}\n\nlet deviceId = msg.payload;\n\nif (!deviceId) {\n    return null;\n}\n\nlet devices = flow.get(\"devices\") || {};\n\nif (devices[deviceId]) {\n\n    delete devices[deviceId];\n\n    flow.set(\"devices\", devices);\n\n    node.warn(\"Device dihapus: \" + deviceId);\n}\n\nreturn null;",
