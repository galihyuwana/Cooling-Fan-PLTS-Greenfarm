    {
        "id": "4909690f8ea10d38",
        "type": "function",
        "z": "4c977091367a5b88",
        "name": "Build Device List",
        "func": "let devices = flow.get(\"devices\") || {};\n\nlet now = Date.now();\n\nlet list = [];\n\nfor (let id in devices) {\n\n    let d = devices[id];\n\n    let online =\n        (now - d.last_seen) <= 15000;\n\n    list.push({\n        device_id: d.device_id,\n        temperature: d.temperature,\n        temperature_status: d.temperature_status,\n        fan: d.fan,\n        mode: d.mode,\n        sensor: d.sensor,\n        wifi_rssi: d.wifi_rssi,\n        last_seen: d.last_seen,\n        online: online\n    });\n}\n\nlist.sort((a, b) =>\n    a.device_id.localeCompare(b.device_id)\n);\n\nmsg.payload = list;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
